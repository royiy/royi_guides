---
// src/pages/index.astro
// Royi Guides — DevOps, Cloud & Infrastructure

const devopsPath = [
  { icon: "🔀", title: "Git", desc: "Version Control & Branching", link: "/devops/git/git-basics/" },
  { icon: "⚙️", title: "CI/CD", desc: "Automation & Pipelines", link: "/devops/cicd/01-מבוא-ל-cicd/" },
  { icon: "🐳", title: "Docker", desc: "Containers & Registries", link: "/devops/docker/01-מבוא-ל-docker/" },
  { icon: "☸️", title: "Kubernetes", desc: "Orchestration & Clusters", link: "/devops/kubernetes/01-mavo-vearchitectura/" },
];

const allTopics = [
  { icon: "🏗️", title: "Terraform", category: "IaC", desc: "Infrastructure as Code, State ו-Modules", link: "/terraform/01-מבוא-ויסודות-terraform/" },
  { icon: "☁️", title: "AWS", category: "Cloud", desc: "Cloud Services, EC2, IAM ו-S3", link: "/aws/aws-exam/" },
  { icon: "🐧", title: "Linux", category: "Infrastructure", desc: "Commands, Permissions ו-Bash", link: "/linux/01-פקודות-בסיסיות/" },
  { icon: "🪟", title: "Windows Server", category: "Infrastructure", desc: "Active Directory, DNS ו-Group Policy", link: "/windows-server/intro/" },
  { icon: "🖥️", title: "VMware", category: "Virtualization", desc: "Virtualization, ESXi ו-vSphere", link: "/vmware/01-virtualization-vmware-basics/" },
  { icon: "💻", title: "PowerShell", category: "Scripting", desc: "Automation, Scripting ו-Modules", link: "/powershell/01-basics/" },
];
---

<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Royi Guides - מדריכים בעברית לעולם IT, Cloud ו-DevOps מעשיים" />
    <title>Royi Guides — DevOps, Cloud & Infrastructure בעברית</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">דילוג לתוכן הראשי</a>

    <!-- Top Navigation Bar -->
    <header class="navbar">
      <div class="container nav-inner">
        <a class="logo" href="/" aria-label="Royi Guides - דף הבית">
          <span class="logo-icon">⚡</span>
          <span class="logo-text">Royi<span class="highlight">Guides</span></span>
        </a>
        <div class="status-badge">
          <span class="status-dot"></span>
          <span>DevOps Path v2.0</span>
        </div>
      </div>
    </header>

    <main id="main-content">
      <!-- Hero Section -->
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-text">
            <div class="badge">🚀 CODE TO PRODUCTION</div>
            <h1>מקוד לפרודקשן<br /><span class="gradient-text">בתוך שניות</span></h1>
            <p>
              Git, CI/CD, Docker, Kubernetes. הכלים שמהנדסים צריכים להכיר בעולם ה-DevOps והתשתיות המודרניות.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="/devops/cicd/01-מבוא-ל-cicd/">🚀 התחל עם CI/CD</a>
              <a class="btn btn-secondary" href="/devops/git/git-basics/">📖 Git & Branching</a>
            </div>
          </div>

          <!-- Code Window / Pipeline Preview -->
          <div class="code-window">
            <div class="window-header">
              <div class="window-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <span class="window-title">deploy-pipeline.yml</span>
            </div>
            <div class="window-body">
              <pre><code><span class="k">name:</span> Production Deploy
<span class="k">on:</span>
  <span class="k">push:</span>
    <span class="k">branches:</span> [ main ]
<span class="k">jobs:</span>
  <span class="k">build-and-deploy:</span>
    <span class="k">runs-on:</span> ubuntu-latest
    <span class="k">steps:</span>
      - <span class="k">uses:</span> actions/checkout@v4
      - <span class="k">name:</span> Build Docker Image
        <span class="s">run: docker build -t app:v1.0 .</span>
      - <span class="k">name:</span> Deploy to K8s Cluster
        <span class="s">run: kubectl apply -f k8s/</span>
<span class="comment"># Status: All checks passed (0.42s) ✓</span></code></pre>
            </div>
          </div>
        </div>
      </section>

      <!-- DevOps Pipeline Section -->
      <section class="pipeline-section">
        <div class="container">
          <div class="section-header">
            <span class="sub-title">🔄 THE PIPELINE</span>
            <h2>DevOps Workflow</h2>
            <p>מסלול הלימוד המבוסס מקוד מקור ועד לניהול קונטיינרים ב-Production</p>
          </div>

          <div class="pipeline-grid">
            {devopsPath.map((step, index) => (
              <a href={step.link} class="pipeline-card">
                <div class="card-top">
                  <span class="step-num">{String(index + 1).padStart(2, '0')}</span>
                  <span class="card-icon">{step.icon}</span>
                </div>
                <h3>{step.title}</h3>
                <p>{step.desc}</p>
                <span class="card-link">למידה והעמקה ←</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- Topics Section -->
      <section class="topics-section">
        <div class="container">
          <div class="section-header">
            <span class="sub-title">📚 LEARN</span>
            <h2>Topics & Guides</h2>
            <p>בחר נושא והתחל ללמוד מדריכים מעשיים בעברית</p>
          </div>

          <div class="topics-grid">
            {allTopics.map((topic) => (
              <a href={topic.link} class="topic-card">
                <div class="topic-header">
                  <span class="topic-icon">{topic.icon}</span>
                  <span class="topic-category">{topic.category}</span>
                </div>
                <h3>{topic.title}</h3>
                <p>{topic.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- Why DevOps / Diff Section -->
      <section class="diff-section">
        <div class="container">
          <div class="section-header">
            <span class="sub-title">💡 WHY DEVOPS</span>
            <h2>Automate Everything</h2>
            <p>בלי DevOps? שבועות. עם DevOps? דקות.</p>
          </div>

          <div class="diff-container">
            <div class="diff-box diff-old">
              <div class="diff-header">❌ No DevOps (עבודה ידנית)</div>
              <ul>
                <li><code>-</code> כתיבה ופריסה ידנית לשרתים</li>
                <li><code>-</code> תקווה שהכל יעבוד ללא בדיקות</li>
                <li><code>-</code> המתנה איטית לאישורי פריסה</li>
                <li><code>-</code> תיקון תקלות ידני ומורכב בזמן אמת</li>
              </ul>
            </div>

            <div class="diff-box diff-new">
              <div class="diff-header">✅ With DevOps (אוטומציה מלאה)</div>
              <ul>
                <li><code>+</code> בדיקות אוטומטיות בכל Push</li>
                <li><code>+</code> Auto-Deploy רציף ללא Downtime</li>
                <li><code>+</code> ניטור רציף והתראות בזמן אמת</li>
                <li><code>+</code> Rollback מיידי בלחיצת כפתור</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section">
        <div class="container">
          <div class="cta-box">
            <h2>Ready to Automate?</h2>
            <p>בחר נושא מהמדריכים והתחל לבנות תשתיות מודרניות עוד היום.</p>
            <div class="hero-actions justify-center">
              <a class="btn btn-primary" href="/devops/cicd/01-מבוא-ל-cicd/">🚀 להתחיל עכשיו</a>
              <a class="btn btn-secondary" href="/devops/git/git-basics/">📖 Git Basics</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Contact Section -->
      <section class="contact-section">
        <div class="container">
          <p>שאלות, הצעות או משוב?</p>
          <a class="contact-email" href="mailto:royiyahud@gmail.com">✉️ royiyahud@gmail.com</a>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="container footer-inner">
        <p>© 2026 <strong>Royi Guides</strong> — DevOps, Cloud & Infrastructure Learning</p>
        <p class="footer-note">מדריכים בעברית לעולם IT מודרני</p>
      </div>
    </footer>

    <style>
      :root {
        --bg: #0b0f17;
        --panel: #111827;
        --panel-hover: #1f293d;
        --border: #1e293b;
        --border-light: #334155;
        
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --text-dim: #64748b;
        
        --accent-cyan: #38bdf8;
        --accent-green: #10b981;
        --accent-orange: #ff7a3d;
        --accent-red: #ef4444;

        --font-sans: 'Heebo', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      
      body {
        background-color: var(--bg);
        color: var(--text-main);
        font-family: var(--font-sans);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* Accessibility */
      .skip-link {
        position: absolute; top: -40px; right: 10px;
        background: var(--accent-cyan); color: #000;
        padding: 8px 16px; font-weight: bold; z-index: 100;
        border-radius: 4px; text-decoration: none;
      }
      .skip-link:focus { top: 10px; }

      /* Navbar */
      .navbar {
        border-bottom: 1px solid var(--border);
        background: rgba(11, 15, 23, 0.85);
        backdrop-filter: blur(12px);
        position: sticky; top: 0; z-index: 50;
      }
      .nav-inner {
        height: 64px; display: flex;
        align-items: center; justify-content: space-between;
      }
      .logo {
        display: flex; align-items: center; gap: 8px;
        text-decoration: none; color: var(--text-main);
        font-weight: 700; font-size: 1.15rem;
      }
      .logo-icon { color: var(--accent-cyan); }
      .logo .highlight { color: var(--accent-cyan); }
      .status-badge {
        display: flex; align-items: center; gap: 8px;
        font-family: var(--font-mono); font-size: 0.75rem;
        color: var(--text-muted); background: var(--panel);
        padding: 4px 12px; border-radius: 99px; border: 1px solid var(--border);
      }
      .status-dot {
        width: 8px; height: 8px; background-color: var(--accent-green);
        border-radius: 50%; box-shadow: 0 0 8px var(--accent-green);
      }

      /* Hero Section */
      .hero { padding: 5rem 0; border-bottom: 1px solid var(--border); }
      .hero-grid {
        display: grid; grid-template-columns: 1.1fr 0.9fr;
        gap: 3.5rem; align-items: center;
      }
      .badge {
        display: inline-block; font-family: var(--font-mono); font-size: 0.8rem;
        color: var(--accent-cyan); background: rgba(56, 189, 248, 0.1);
        border: 1px solid rgba(56, 189, 248, 0.3); padding: 4px 12px;
        border-radius: 99px; margin-bottom: 1rem;
      }
      .hero-text h1 {
        font-size: 2.75rem; line-height: 1.2; font-weight: 700; margin-bottom: 1rem;
      }
      .gradient-text {
        background: linear-gradient(135deg, var(--accent-cyan), var(--accent-green));
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      }
      .hero-text p { color: var(--text-muted); font-size: 1.1rem; margin-bottom: 2rem; }
      .hero-actions { display: flex; gap: 1rem; }
      .justify-center { justify-content: center; }

      .btn {
        display: inline-flex; align-items: center; justify-content: center;
        padding: 12px 24px; border-radius: 8px; font-weight: 600;
        text-decoration: none; transition: all 0.2s ease; font-size: 0.95rem;
      }
      .btn-primary { background: var(--accent-cyan); color: #000; }
      .btn-primary:hover { opacity: 0.9; transform: translateY(-2px); }
      .btn-secondary { background: var(--panel); color: var(--text-main); border: 1px solid var(--border-light); }
      .btn-secondary:hover { background: var(--panel-hover); border-color: var(--text-muted); }

      /* Code Window */
      .code-window {
        background: var(--panel); border: 1px solid var(--border-light);
        border-radius: 12px; overflow: hidden; font-family: var(--font-mono);
        direction: ltr; text-align: left; box-shadow: 0 20px 40px rgba(0,0,0,0.5);
      }
      .window-header {
        background: #0d121d; padding: 10px 16px; border-bottom: 1px solid var(--border);
        display: flex; align-items: center; justify-content: space-between;
      }
      .window-dots { display: flex; gap: 6px; }
      .dot { width: 10px; height: 10px; border-radius: 50%; }
      .dot.red { background: #ff5f56; }
      .dot.yellow { background: #ffbd2e; }
      .dot.green { background: #27c93f; }
      .window-title { font-size: 0.75rem; color: var(--text-dim); }
      .window-body { padding: 1.25rem; font-size: 0.85rem; line-height: 1.7; overflow-x: auto; }
      .window-body .k { color: var(--accent-cyan); }
      .window-body .s { color: var(--accent-green); }
      .window-body .comment { color: var(--text-dim); font-style: italic; display: block; margin-top: 8px; }

      /* Section Common */
      .section-header { text-align: center; margin-bottom: 3rem; }
      .sub-title {
        font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em;
        color: var(--accent-cyan); display: block; margin-bottom: 0.5rem;
      }
      .section-header h2 { font-size: 2rem; margin-bottom: 0.5rem; }
      .section-header p { color: var(--text-muted); }

      /* Pipeline Grid */
      .pipeline-section { padding: 5rem 0; border-bottom: 1px solid var(--border); }
      .pipeline-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;
      }
      .pipeline-card {
        background: var(--panel); border: 1px solid var(--border);
        border-radius: 12px; padding: 1.75rem; text-decoration: none; color: var(--text-main);
        transition: all 0.25s ease; display: flex; flex-direction: column;
      }
      .pipeline-card:hover {
        border-color: var(--accent-cyan); transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(56, 189, 248, 0.1);
      }
      .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
      .step-num { font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent-cyan); font-weight: bold; }
      .card-icon { font-size: 1.5rem; }
      .pipeline-card h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }
      .pipeline-card p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem; flex-grow: 1; }
      .card-link { font-size: 0.85rem; font-weight: 600; color: var(--accent-cyan); }

      /* Topics Section */
      .topics-section { padding: 5rem 0; border-bottom: 1px solid var(--border); }
      .topics-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;
      }
      .topic-card {
        background: var(--panel); border: 1px solid var(--border);
        border-radius: 10px; padding: 1.5rem; text-decoration: none; color: var(--text-main);
        transition: all 0.2s ease;
      }
      .topic-card:hover { border-color: var(--border-light); background: var(--panel-hover); }
      .topic-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; }
      .topic-icon { font-size: 1.4rem; }
      .topic-category {
        font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-dim);
        background: var(--bg); padding: 2px 8px; border-radius: 4px; border: 1px solid var(--border);
      }
      .topic-card h3 { font-size: 1.1rem; margin-bottom: 0.4rem; }
      .topic-card p { color: var(--text-muted); font-size: 0.88rem; }

      /* Diff Section */
      .diff-section { padding: 5rem 0; border-bottom: 1px solid var(--border); }
      .diff-container { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
      .diff-box {
        background: var(--panel); border: 1px solid var(--border); border-radius: 12px;
        padding: 1.75rem; font-family: var(--font-mono); font-size: 0.88rem;
      }
      .diff-header { font-weight: bold; margin-bottom: 1.25rem; font-size: 1rem; }
      .diff-box ul { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; }
      .diff-old { border-color: rgba(239, 68, 68, 0.3); }
      .diff-old .diff-header { color: var(--accent-red); }
      .diff-old code { color: var(--accent-red); font-weight: bold; margin-left: 6px; }
      .diff-old li { color: #fca5a5; }

      .diff-new { border-color: rgba(16, 185, 129, 0.3); }
      .diff-new .diff-header { color: var(--accent-green); }
      .diff-new code { color: var(--accent-green); font-weight: bold; margin-left: 6px; }
      .diff-new li { color: #6ee7b7; }

      /* CTA Section */
      .cta-section { padding: 5rem 0; border-bottom: 1px solid var(--border); }
      .cta-box {
        background: var(--panel); border: 1px solid var(--border-light);
        border-radius: 16px; padding: 3.5rem 2rem; text-align: center;
      }
      .cta-box h2 { font-size: 2rem; margin-bottom: 0.75rem; }
      .cta-box p { color: var(--text-muted); margin-bottom: 2rem; font-size: 1.05rem; }

      /* Contact Section */
      .contact-section { padding: 3rem 0; text-align: center; }
      .contact-section p { color: var(--text-muted); margin-bottom: 0.5rem; }
      .contact-email { color: var(--accent-cyan); font-weight: 600; text-decoration: none; font-size: 1.1rem; }
      .contact-email:hover { text-decoration: underline; }

      /* Footer */
      .footer {
        border-top: 1px solid var(--border); padding: 2.5rem 0;
        color: var(--text-dim); font-size: 0.88rem; text-align: center;
      }
      .footer-inner { display: flex; flex-direction: column; gap: 0.4rem; align-items: center; }
      .footer strong { color: var(--text-muted); }
      .footer-note { font-size: 0.8rem; }

      /* Responsive Media Queries */
      @media (max-width: 900px) {
        .hero-grid, .diff-container { grid-template-columns: 1fr; }
        .hero-text h1 { font-size: 2.2rem; }
      }
      @media (max-width: 600px) {
        .hero-actions { flex-direction: column; }
        .btn { width: 100%; }
      }
    </style>
  </body>
</html>