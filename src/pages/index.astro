---
// src/pages/index.astro
// דף הבית - עיצוב "night-shift ops console": טורקיז-שחור, אותות כתומים, JetBrains Mono

const topics = [
  { icon: "☁️", title: "AWS", path: "~/topics/aws", desc: "שירותי ענן, ארכיטקטורה, אבטחה ו-Solutions Architect", link: "/aws/aws-exam/" },
  { icon: "🐧", title: "Linux", path: "~/topics/linux", desc: "פקודות, הרשאות, שירותים, Networking וניהול שרתים", link: "/linux/intro/" },
  { icon: "🪟", title: "Windows Server", path: "~/topics/win-server", desc: "Active Directory, DNS, DHCP, GPO וניהול שרתים", link: "/windows-server/intro/" },
  { icon: "⚙️", title: "DevOps", path: "~/topics/devops", desc: "Git, CI/CD, Docker, Kubernetes ואוטומציה", link: "/devops/git-basics/" },
  { icon: "🖥️", title: "VMware", path: "~/topics/vmware", desc: "vSphere, ESXi, vCenter, HA וירטואליזציה", link: "/vmware/intro/" },
  { icon: "🏗️", title: "Terraform", path: "~/topics/terraform", desc: "Infrastructure as Code וניהול תשתיות בענן", link: "/terraform/intro/" },
  { icon: "💻", title: "PowerShell", path: "~/topics/powershell", desc: "אוטומציה, ניהול Windows וסקריפטים", link: "/powershell/intro/" },
];

const features = [
  { flag: "--focused", desc: "תוכן" },
  { flag: "--practical", desc: "דוגמאות ותרחישים מהעולם האמיתי" },
  { flag: "--hebrew", desc: "ידע טכני" },
  { flag: "--growing", desc: "תוכן חדש ונושאים נוספים" },
];
---

<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Royi Guides — לומדים IT</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Hebrew:wght@500;600;700&family=Heebo:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a class="logo" href="/">
          <span class="logo-badge">📗</span>
          <span>Royi Guides</span>
        </a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-inner">
          <div class="hero-content">
            <span class="eyebrow">IT • CLOUD • DEVOPS</span>
            <h1>לומדים IT.<br /><span>בונים ידע. מתקדמים.</span></h1>
            <p>
              מדריכים ומאמרים מעשיים בעברית לעולם ה-IT, Cloud, Infrastructure ו DevOps
            </p>
            <div class="buttons">
              <a class="btn btn-primary" href="/devops/git-basics/">🚀 התחל ללמוד</a>
            </div>
          </div>

          <div class="terminal">
            <div class="terminal-bar">
              <span class="dot"></span><span class="dot"></span><span class="dot"></span>
              <span class="terminal-title">bash — royi-guides</span>
            </div>
            <div class="terminal-body">
              <div class="term-line">
                <span class="term-prompt">royi@guides</span><span class="term-comment">:</span><span class="term-path">~</span><span class="term-comment">$ </span><span class="term-output">ls topics/</span>
              </div>
              <div class="term-line">aws/ linux/ windows-server/ devops/</div>
              <div class="term-line">vmware/ terraform/ powershell/</div>
              <div class="term-line">&nbsp;</div>
              <div class="term-line">
                <span class="term-prompt">royi@guides</span><span class="term-comment">:</span><span class="term-path">~</span><span class="term-comment">$ </span><span class="term-output">./start-learning.sh</span>
              </div>
              <div class="term-line">
                <span class="term-comment">&gt; מתחילים ללמוד תשתיות, ענן ו-DevOps</span>
              </div>
              <div class="term-line">
                <span class="term-prompt">royi@guides</span><span class="term-comment">:</span><span class="term-path">~</span><span class="term-comment">$ </span><span class="cursor"></span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="topics">
        <div class="section-header">
          <span class="eyebrow">נושאים</span>
          <h2>נושאים מרכזיים</h2>
          <p>בחר נושא והתחל ללמוד בקצב שלך</p>
        </div>

        <div class="topic-grid">
          {
            topics.map((t) => (
              <a class="topic-card" href={t.link}>
                <div class="topic-path">{t.path}</div>
                <div class="topic-icon">{t.icon}</div>
                <h3>{t.title}</h3>
                <p>{t.desc}</p>
                <span class="learn-more">התחל ללמוד ←</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="why-us">
        <div class="why-grid">
          <div>
            <span class="eyebrow">לימוד מעשי</span>
            <h2>לא רק לקרוא.<br /><span>גם להבין איך זה עובד.</span></h2>
            <p>
              המטרה של Royi Guides היא להפוך נושאים מורכבים בעולם התשתיות,
              הענן וה-DevOps לתוכן ברור, מעשי ונגיש.
            </p>
          </div>

          <div class="features">
            {
              features.map((f) => (
                <div class="feature-item">
                  <strong>{f.flag}</strong>
                  <span>{f.desc}</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="contact">
        <p>שאלות או הצעות? נשמח שתפנו אלינו במייל</p>
        <a class="contact-email" href="mailto:royiyahud@gmail.com">royiyahud@gmail.com</a>
      </section>
    </main>

    <footer class="site-footer">© 2026 Royi Guides</footer>

    <style>
      :root {
        --ia-ink: #0e1a1f;
        --ia-ink-soft: #101d23;
        --ia-panel: #142229;
        --ia-panel-2: #182a32;
        --ia-line: #24363e;
        --ia-line-soft: #1b2a31;
        --ia-text: #eef4f2;
        --ia-text-dim: #9fb3ae;
        --ia-text-faint: #6e8480;
        --ia-signal: #ff8a3d;
        --ia-signal-soft: rgba(255, 138, 61, 0.14);
        --ia-wire: #6fe3c4;
        --ia-wire-soft: rgba(111, 227, 196, 0.14);
        --font-display: "IBM Plex Sans Hebrew", "Heebo", sans-serif;
        --font-body: "Heebo", sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, "Courier New", monospace;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--ia-ink);
        color: var(--ia-text);
        font-family: var(--font-body);
      }

      .nav {
        border-bottom: 1px solid var(--ia-line);
        background: rgba(14, 26, 31, 0.9);
        backdrop-filter: blur(6px);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .nav-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-display);
        font-weight: 700;
        color: var(--ia-text);
        text-decoration: none;
      }

      .logo-badge {
        display: inline-flex;
        width: 28px;
        height: 28px;
        align-items: center;
        justify-content: center;
        background: var(--ia-wire-soft);
        border-radius: 6px;
      }

      .nav-links {
        display: flex;
        gap: 1.5rem;
      }

      .nav-links a {
        color: var(--ia-text);
        text-decoration: none;
        font-size: 0.95rem;
      }

      .nav-links a:hover {
        color: var(--ia-signal);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        color: var(--ia-signal);
        background: var(--ia-signal-soft);
        border: 1px solid rgba(255, 138, 61, 0.3);
        border-radius: 999px;
        padding: 0.4rem 0.9rem;
      }

      .eyebrow::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--ia-signal);
        box-shadow: 0 0 8px 1px var(--ia-signal);
      }

      .hero {
        position: relative;
        padding: 5rem 0;
        overflow: hidden;
        border-bottom: 1px solid var(--ia-line);
        background-image:
          radial-gradient(circle at 15% 20%, rgba(255, 138, 61, 0.08), transparent 40%),
          radial-gradient(circle at 85% 80%, rgba(111, 227, 196, 0.08), transparent 42%),
          linear-gradient(var(--ia-line-soft) 1px, transparent 1px),
          linear-gradient(90deg, var(--ia-line-soft) 1px, transparent 1px);
        background-size: auto, auto, 42px 42px, 42px 42px;
      }

      .hero-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 3rem;
        align-items: center;
      }

      .hero-content h1 {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2.1rem, 4.2vw, 3.1rem);
        line-height: 1.2;
        margin: 1rem 0 1rem;
      }

      .hero-content h1 span {
        color: var(--ia-signal);
      }

      .hero-content p {
        font-size: 1.05rem;
        line-height: 1.75;
        color: var(--ia-text-dim);
        max-width: 34rem;
        margin-bottom: 2rem;
      }

      .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
      }

      .btn {
        font-weight: 600;
        font-size: 1rem;
        padding: 0.85rem 1.7rem;
        border-radius: 8px;
        border: 1px solid transparent;
        text-decoration: none;
        display: inline-block;
      }

      .btn-primary {
        background: var(--ia-signal);
        color: var(--ia-ink);
      }

      .btn-secondary {
        background: transparent;
        color: var(--ia-text);
        border-color: var(--ia-line);
      }

      .terminal {
        background: var(--ia-panel);
        border: 1px solid var(--ia-line);
        border-radius: 12px;
        overflow: hidden;
        direction: ltr;
        text-align: left;
      }

      .terminal-bar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 0.9rem;
        background: var(--ia-panel-2);
        border-bottom: 1px solid var(--ia-line);
      }

      .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #3a4a51;
        display: inline-block;
      }

      .terminal-title {
        margin-inline-start: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--ia-text-faint);
      }

      .terminal-body {
        padding: 1.4rem 1.25rem 1.6rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        line-height: 1.9;
      }

      .term-line {
        display: block;
        color: var(--ia-text-dim);
      }

      .term-prompt {
        color: var(--ia-wire);
      }

      .term-path {
        color: var(--ia-signal);
      }

      .term-output {
        color: var(--ia-text);
      }

      .term-comment {
        color: var(--ia-text-faint);
        unicode-bidi: plaintext;
      }

      .cursor {
        display: inline-block;
        width: 7px;
        height: 1rem;
        background: var(--ia-signal);
        margin-inline-start: 2px;
        vertical-align: text-bottom;
      }

      .topics {
        background: var(--ia-ink-soft);
        padding: 5rem 0;
      }

      .section-header,
      .topic-grid,
      .why-grid {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .section-header {
        max-width: 34rem;
        margin-bottom: 2.5rem;
      }

      .section-header h2 {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.7rem, 2.6vw, 2.2rem);
        margin: 0.9rem 0 0.6rem;
      }

      .section-header p {
        color: var(--ia-text-dim);
        font-size: 1rem;
      }

      .topic-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1.1rem;
      }

      .topic-card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        background: var(--ia-panel);
        border: 1px solid var(--ia-line);
        border-radius: 10px;
        padding: 1.6rem 1.5rem 1.5rem;
        text-decoration: none;
        color: var(--ia-text);
      }

      .topic-card::before {
        content: "";
        position: absolute;
        inset-inline-start: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        border-radius: 10px 0 0 10px;
      }

      .topic-card:nth-child(odd)::before {
        background: linear-gradient(var(--ia-signal), transparent);
      }

      .topic-card:nth-child(even)::before {
        background: linear-gradient(var(--ia-wire), transparent);
      }

      .topic-card:hover {
        border-color: var(--ia-line-soft);
      }

      .topic-path {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--ia-text-faint);
        direction: ltr;
        text-align: right;
      }

      .topic-icon {
        font-size: 1.6rem;
        width: 2.75rem;
        height: 2.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--ia-panel-2);
        border: 1px solid var(--ia-line);
        border-radius: 8px;
      }

      .topic-card h3 {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.15rem;
        margin: 0;
      }

      .topic-card p {
        color: var(--ia-text-dim);
        font-size: 0.94rem;
        line-height: 1.6;
        margin: 0;
        flex-grow: 1;
      }

      .learn-more {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--ia-signal);
      }

      .why-us {
        padding: 5.5rem 0;
        border-top: 1px solid var(--ia-line);
      }

      .why-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: start;
      }

      .why-us h2 {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.7rem, 2.6vw, 2.2rem);
        margin: 1rem 0 1.1rem;
        line-height: 1.3;
      }

      .why-us h2 span {
        color: var(--ia-wire);
      }

      .contact {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem 5rem;
        text-align: center;
      }

      .contact p {
        color: var(--ia-text-dim);
        font-size: 1rem;
        margin: 0 0 0.5rem;
      }

      .contact-email {
        color: var(--ia-wire);
        font-family: var(--font-mono);
        font-size: 1.05rem;
        text-decoration: none;
      }

      .contact-email:hover {
        text-decoration: underline;
      }

      .why-grid > div:first-child p {
        color: var(--ia-text-dim);
        font-size: 1.02rem;
        line-height: 1.75;
        max-width: 30rem;
      }

      .features {
        display: grid;
        gap: 1.1rem;
      }

      .feature-item {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        padding: 1.1rem 1.3rem;
        background: var(--ia-panel);
        border: 1px solid var(--ia-line);
        border-inline-start: 3px solid var(--ia-wire);
        border-radius: 8px;
      }

      .feature-item strong {
        font-family: var(--font-mono);
        font-size: 0.92rem;
        color: var(--ia-wire);
        direction: ltr;
        text-align: right;
        display: block;
      }

      .feature-item span {
        color: var(--ia-text-dim);
        font-size: 0.94rem;
      }

      .site-footer {
        border-top: 1px solid var(--ia-line);
        text-align: center;
        padding: 1.5rem;
        color: var(--ia-text-dim);
        font-size: 0.85rem;
      }

      .footer-link {
        color: var(--ia-wire);
        text-decoration: none;
      }

      .footer-link:hover {
        text-decoration: underline;
      }

      @media (max-width: 996px) {
        .hero-inner {
          grid-template-columns: 1fr;
        }
        .why-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
