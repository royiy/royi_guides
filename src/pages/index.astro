---
// src/pages/index.astro
// דף בית משופר - Beautiful, Accessible, DevOps-focused

// DevOps-ממוקד - לימוד מובנה מ-Git ועד Kubernetes
const devopsPath = [
  { icon: "🔀", title: "Git & Branching", desc: "קטגוריה: Git, GitHub, GitLab", link: "/devops/git/git-basics/" },
  { icon: "⚙️", title: "CI/CD", desc: "קטגוריה: Jenkins, GitHub Actions, GitLab CI", link: "/devops/cicd/01-מבוא-ל-cicd/" },
  { icon: "🐳", title: "Docker", desc: "קטגוריה: Containers, Images, Compose", link: "/devops/docker/01-מבוא-ל-docker/" },
  { icon: "☸️", title: "Kubernetes", desc: "קטגוריה: Orchestration, Deployment", link: "/devops/kubernetes/kubernetes-intro/" },
];

const allTopics = [
  { icon: "☁️", title: "AWS", path: "~/topics/aws", desc: "שירותי ענן, ארכיטקטורה, אבטחה", link: "/aws/aws-exam/", category: "Cloud" },
  { icon: "🐧", title: "Linux", path: "~/topics/linux", desc: "פקודות, הרשאות, שירותים, Networking", link: "/linux/01-פקודות-בסיסיות/", category: "Infrastructure" },
  { icon: "🪟", title: "Windows Server", path: "~/topics/win-server", desc: "Active Directory, DNS, DHCP, GPO", link: "/windows-server/intro/", category: "Infrastructure" },
  { icon: "🏗️", title: "Terraform", path: "~/topics/terraform", desc: "Infrastructure as Code, Cloud Provisioning", link: "/terraform/01-מבוא-ויסודות-terraform/", category: "IaC" },
  { icon: "🖥️", title: "VMware", path: "~/topics/vmware", desc: "vSphere, ESXi, vCenter, HA", link: "/vmware/01-virtualization-vmware-basics/", category: "Virtualization" },
  { icon: "💻", title: "PowerShell", path: "~/topics/powershell", desc: "אוטומציה, ניהול Windows, סקריפטים", link: "/powershell/01-basics/", category: "Scripting" },
];

const features = [
  { icon: "🎯", title: "Focused", desc: "תוכן טכני מדויק ללא רעש" },
  { icon: "⚡", title: "Practical", desc: "דוגמאות וטרחישים מעולם האמיתי" },
  { icon: "🇮🇱", title: "Hebrew", desc: "ידע אנגלי בחברה עברית" },
  { icon: "🚀", title: "DevOps First", desc: "עדיפות ללימוד מודרני של תשתיות" },
];
---

<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Royi Guides - מדריכים בעברית לעולם IT, Cloud ו-DevOps מעשיים" />
    <title>Royi Guides — DevOps, Cloud & Infrastructure בעברית</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Hebrew:wght@500;600;700&family=Heebo:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">לדלג לתוכן ראשי</a>

    <header class="nav" role="banner">
      <div class="nav-inner">
        <a class="logo" href="/" aria-label="Royi Guides - בית">
          <span class="logo-badge">📚</span>
          <span>Royi Guides</span>
        </a>
        <span class="tagline">DevOps • Cloud • Infrastructure</span>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" aria-label="הקדמה">
        <div class="hero-inner">
          <div class="hero-content">
            <span class="eyebrow">🚀 DEVOPS & INFRASTRUCTURE</span>
            <h1>בונים<br /><span>תשתיות עוצמתיות</span></h1>
            <p>
              למדו את עולם DevOps, Cloud ו-Infrastructure עם מדריכים מעשיים בעברית.
              מ-Git ו-CI/CD ועד Kubernetes וTerraform.
            </p>
            <div class="buttons">
              <a class="btn btn-primary" href="/devops/cicd/01-מבוא-ל-cicd/">🚀 התחל עם CI/CD</a>
              <a class="btn btn-secondary" href="/devops/git/git-basics/">📖 Git & Branching</a>
            </div>
          </div>

          <div class="terminal" role="img" aria-label="דוגמה של טרמינל">
            <div class="terminal-bar">
              <span class="dot"></span><span class="dot"></span><span class="dot"></span>
              <span class="terminal-title">bash — devops-learning</span>
            </div>
            <div class="terminal-body">
              <div class="term-line">
                <span class="term-prompt">ops@royi</span><span class="term-comment">:</span><span class="term-path">~/learning</span><span class="term-comment">$ </span><span class="term-output">git log</span>
              </div>
              <div class="term-line" style="color: var(--ia-wire);">commit fa3d9e2 (HEAD → main)</div>
              <div class="term-line" style="color: var(--ia-text-dim);">DevOps pipeline working ✨</div>
              <div class="term-line">&nbsp;</div>
              <div class="term-line">
                <span class="term-prompt">ops@royi</span><span class="term-comment">:</span><span class="term-path">~/learning</span><span class="term-comment">$ </span><span class="term-output">docker ps</span>
              </div>
              <div class="term-line" style="color: var(--ia-wire);">CONTAINER ID  STATUS  NAMES</div>
              <div class="term-line">e4d5f9a2  Up     kubernetes-pod</div>
              <div class="term-line">
                <span class="term-prompt">ops@royi</span><span class="term-comment">:</span><span class="term-path">~/learning</span><span class="term-comment">$ </span><span class="cursor"></span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="devops-pipeline" aria-label="DevOps Learning Path">
        <div class="section-header">
          <span class="eyebrow">📈 מסלול הלימוד</span>
          <h2>DevOps בשלבים</h2>
          <p>לימוד מובנה מ-Git ועד Kubernetes</p>
        </div>

        <div class="pipeline-container">
          {
            devopsPath.map((step, index) => (
              <a class="pipeline-step" href={step.link} title={`לך ל-${step.title}`}>
                <div class="pipeline-icon">{step.icon}</div>
                <div class="pipeline-content">
                  <h3>{step.title}</h3>
                  <p>{step.desc}</p>
                </div>
                {index < devopsPath.length - 1 && <div class="pipeline-arrow">→</div>}
              </a>
            ))
          }
        </div>
      </section>

      <section class="topics" aria-label="נושאים">
        <div class="section-header">
          <span class="eyebrow">📚 נושאים</span>
          <h2>כל הנושאים</h2>
          <p>בחר נושא והתחל ללמוד</p>
        </div>

        <div class="topics-wrapper">
          <!-- DevOps & Automation -->
          <div class="topics-category">
            <h3 class="category-title">🚀 DevOps & Automation</h3>
            <div class="topic-grid">
              {
                allTopics.filter(t => t.title === "Terraform").map((t) => (
                  <a class="topic-card" href={t.link} title={t.desc}>
                    <div class="topic-icon">{t.icon}</div>
                    <h4>{t.title}</h4>
                    <p>{t.desc}</p>
                    <span class="learn-more">להמשך ←</span>
                  </a>
                ))
              }
            </div>
          </div>

          <!-- Infrastructure -->
          <div class="topics-category">
            <h3 class="category-title">🏢 Infrastructure</h3>
            <div class="topic-grid">
              {
                allTopics.filter(t => t.category === "Infrastructure").map((t) => (
                  <a class="topic-card" href={t.link} title={t.desc}>
                    <div class="topic-icon">{t.icon}</div>
                    <h4>{t.title}</h4>
                    <p>{t.desc}</p>
                    <span class="learn-more">להמשך ←</span>
                  </a>
                ))
              }
            </div>
          </div>

          <!-- Cloud & Other -->
          <div class="topics-category">
            <h3 class="category-title">☁️ Cloud & Other</h3>
            <div class="topic-grid">
              {
                allTopics.filter(t => t.category === "Cloud" || t.category === "Virtualization" || t.category === "Scripting").map((t) => (
                  <a class="topic-card" href={t.link} title={t.desc}>
                    <div class="topic-icon">{t.icon}</div>
                    <h4>{t.title}</h4>
                    <p>{t.desc}</p>
                    <span class="learn-more">להמשך ←</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="why-us" aria-label="למה Royi Guides">
        <div class="section-header why-header">
          <span class="eyebrow">✨ למה בחרנו DevOps</span>
          <h2>DevOps הוא העתיד</h2>
          <p>
            תשתיות מודרניות דורשות חשיבה שונה. Royi Guides מלמד את הכלים,
            ההתנהגויות והתהליכים שמהנדסים דורשים בעולם היום.
          </p>
        </div>

        <div class="why-grid">
          <div class="features-list">
            {
              features.map((f) => (
                <div class="feature-item">
                  <span class="feature-icon">{f.icon}</span>
                  <div>
                    <strong>{f.title}</strong>
                    <p>{f.desc}</p>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="why-content">
            <div class="benefit-box">
              <h3>למה DevOps?</h3>
              <ul>
                <li>🔄 <strong>Continuous Integration/Deployment</strong> - שינויים מהירים וחוזרים</li>
                <li>🐳 <strong>Containerization</strong> - תאימות וקנה מידה</li>
                <li>☸️ <strong>Orchestration</strong> - ניהול עומסים ויעילות</li>
                <li>♻️ <strong>Infrastructure as Code</strong> - בקרה גרסאות על תשתיות</li>
                <li>📊 <strong>Monitoring & Observability</strong> - הבנת מה קורה בפרודקשן</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="cta" aria-label="להתחיל">
        <div class="cta-content">
          <h2>מוכן ללמוד?</h2>
          <p>בחר נושא וקדם לעבר IT מוקדש של מהנדסי DevOps מודרניים</p>
          <div class="buttons">
            <a class="btn btn-primary" href="/devops/cicd/01-מבוא-ל-cicd/">🚀 התחל עכשיו</a>
            <a class="btn btn-secondary" href="/devops/git/git-basics/">📖 Git Basics</a>
          </div>
        </div>
      </section>

      <section class="contact" aria-label="יצירת קשר">
        <p>שאלות, הצעות או משוב?</p>
        <a class="contact-email" href="mailto:royiyahud@gmail.com">✉️ royiyahud@gmail.com</a>
      </section>
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="footer-inner">
        <p>&copy; 2026 <strong>Royi Guides</strong> — DevOps, Cloud & Infrastructure Learning</p>
        <p class="footer-note">מדריכים בעברית לעולם IT מודרני</p>
      </div>
    </footer>

    <style>
      :root {
        --ia-ink: #0a1217;
        --ia-ink-soft: #0f1820;
        --ia-panel: #14202a;
        --ia-panel-2: #1a2a36;
        --ia-panel-3: #243545;
        --ia-line: #2a3f4f;
        --ia-line-soft: #1f3038;
        --ia-text: #f5f9fa;
        --ia-text-dim: #a8c5ce;
        --ia-text-faint: #7a8f99;
        --ia-signal: #ff7a3d;
        --ia-signal-soft: rgba(255, 122, 61, 0.12);
        --ia-signal-light: rgba(255, 122, 61, 0.25);
        --ia-wire: #00d9a3;
        --ia-wire-soft: rgba(0, 217, 163, 0.12);
        --ia-wire-light: rgba(0, 217, 163, 0.25);
        --ia-accent-blue: #00c9ff;
        --font-display: "IBM Plex Sans Hebrew", "Heebo", sans-serif;
        --font-body: "Heebo", sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, "Courier New", monospace;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: linear-gradient(135deg, var(--ia-ink) 0%, var(--ia-ink-soft) 100%);
        color: var(--ia-text);
        font-family: var(--font-body);
        line-height: 1.6;
      }

      /* Accessibility */
      .skip-link {
        position: absolute;
        top: -40px;
        right: 0;
        background: var(--ia-signal);
        color: var(--ia-ink);
        padding: 8px 16px;
        text-decoration: none;
        z-index: 100;
        border-radius: 0 0 0 4px;
        font-weight: 600;
      }

      .skip-link:focus {
        top: 0;
      }

      /* Navigation */
      .nav {
        border-bottom: 1px solid var(--ia-line);
        background: rgba(10, 18, 23, 0.92);
        backdrop-filter: blur(12px);
        position: sticky;
        top: 0;
        z-index: 10;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
      }

      .nav-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--ia-text);
        text-decoration: none;
        transition: transform 0.3s ease;
      }

      .logo:hover {
        transform: scale(1.02);
      }

      .logo-badge {
        display: inline-flex;
        width: 32px;
        height: 32px;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--ia-wire-soft), var(--ia-signal-soft));
        border: 1px solid var(--ia-line);
        border-radius: 8px;
        font-size: 1.2rem;
      }

      .tagline {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        color: var(--ia-text-faint);
      }

      /* Eyebrow */
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ia-signal);
        background: var(--ia-signal-light);
        border: 1px solid rgba(255, 122, 61, 0.4);
        border-radius: 999px;
        padding: 0.5rem 1rem;
      }

      /* Hero Section */
      .hero {
        position: relative;
        padding: 4.5rem 0;
        overflow: hidden;
        border-bottom: 1px solid var(--ia-line);
        background: 
          radial-gradient(circle at 20% 30%, rgba(255, 122, 61, 0.12), transparent 45%),
          radial-gradient(circle at 80% 70%, rgba(0, 217, 163, 0.08), transparent 50%);
      }

      .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(var(--ia-line-soft) 1px, transparent 1px),
          linear-gradient(90deg, var(--ia-line-soft) 1px, transparent 1px);
        background-size: 50px 50px;
        opacity: 0.3;
        pointer-events: none;
      }

      .hero-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 3rem;
        align-items: center;
        position: relative;
        z-index: 1;
      }

      .hero-content h1 {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2.2rem, 5vw, 3.2rem);
        line-height: 1.15;
        margin: 0.5rem 0 1.5rem;
        letter-spacing: -0.02em;
      }

      .hero-content h1 span {
        background: linear-gradient(135deg, var(--ia-signal), var(--ia-accent-blue));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .hero-content p {
        font-size: 1.08rem;
        line-height: 1.8;
        color: var(--ia-text-dim);
        max-width: 38rem;
        margin-bottom: 2rem;
      }

      .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .btn {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1rem;
        padding: 1rem 1.8rem;
        border-radius: 8px;
        border: none;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .btn:focus {
        outline: 2px solid var(--ia-signal);
        outline-offset: 2px;
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--ia-signal), #ff5c1f);
        color: var(--ia-ink);
        box-shadow: 0 8px 24px rgba(255, 122, 61, 0.2);
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(255, 122, 61, 0.3);
      }

      .btn-secondary {
        background: transparent;
        color: var(--ia-text);
        border: 2px solid var(--ia-line);
      }

      .btn-secondary:hover {
        border-color: var(--ia-wire);
        background: rgba(0, 217, 163, 0.08);
      }

      /* Terminal */
      .terminal {
        background: var(--ia-panel);
        border: 1px solid var(--ia-line);
        border-radius: 12px;
        overflow: hidden;
        direction: ltr;
        text-align: left;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
      }

      .terminal-bar {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.9rem 1.2rem;
        background: var(--ia-panel-2);
        border-bottom: 1px solid var(--ia-line);
      }

      .dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: #4a5f6a;
        display: inline-block;
      }

      .terminal-title {
        margin-inline-start: 0.6rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--ia-text-faint);
      }

      .terminal-body {
        padding: 1.6rem 1.4rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        line-height: 1.95;
      }

      .term-line {
        display: block;
        color: var(--ia-text-dim);
      }

      .term-prompt {
        color: var(--ia-wire);
        font-weight: 600;
      }

      .term-path {
        color: var(--ia-signal);
      }

      .term-output {
        color: var(--ia-text);
      }

      .term-comment {
        color: var(--ia-text-faint);
      }

      .cursor {
        display: inline-block;
        width: 8px;
        height: 1rem;
        background: var(--ia-signal);
        margin-inline-start: 3px;
        animation: blink 1s infinite;
      }

      @keyframes blink {
        0%, 49%, 100% { opacity: 1; }
        50%, 99% { opacity: 0.3; }
      }

      /* DevOps Pipeline */
      .devops-pipeline {
        padding: 5rem 0;
        background: linear-gradient(135deg, rgba(0, 217, 163, 0.04) 0%, rgba(255, 122, 61, 0.04) 100%);
        border-bottom: 1px solid var(--ia-line);
      }

      .pipeline-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: flex;
        gap: 1.5rem;
        align-items: center;
        flex-wrap: wrap;
        justify-content: center;
      }

      .pipeline-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
        color: inherit;
        flex: 0 1 200px;
        padding: 1.5rem;
        background: var(--ia-panel);
        border: 2px solid var(--ia-line);
        border-radius: 12px;
        transition: all 0.3s ease;
        position: relative;
      }

      .pipeline-step:hover {
        background: var(--ia-panel-2);
        border-color: var(--ia-wire);
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0, 217, 163, 0.15);
      }

      .pipeline-icon {
        font-size: 2.2rem;
      }

      .pipeline-content h3 {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.05rem;
        margin: 0;
        text-align: center;
      }

      .pipeline-content p {
        font-size: 0.85rem;
        color: var(--ia-text-faint);
        margin: 0;
        text-align: center;
      }

      .pipeline-arrow {
        display: none;
        font-size: 1.5rem;
        color: var(--ia-wire);
        animation: slideRight 1.5s ease-in-out infinite;
      }

      @media (min-width: 768px) {
        .pipeline-arrow {
          display: block;
          position: absolute;
          inset-inline-start: -1.75rem;
        }
      }

      @keyframes slideRight {
        0%, 100% { transform: translateX(0); }
        50% { transform: translateX(4px); }
      }

      /* Topics Section */
      .topics {
        background: var(--ia-ink-soft);
        padding: 5rem 0;
      }

      .section-header {
        max-width: 1200px;
        margin: 0 auto 3rem;
        padding: 0 1.5rem;
      }

      .section-header h2 {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.8rem, 3vw, 2.3rem);
        margin: 0.8rem 0 0.6rem;
      }

      .section-header p {
        color: var(--ia-text-dim);
        font-size: 1rem;
        margin: 0;
      }

      .topics-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 3.5rem;
      }

      .topics-category {
        animation: fadeInUp 0.6s ease-out;
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .category-title {
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 600;
        margin: 0 0 1.5rem 0;
        color: var(--ia-text);
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .topic-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .topic-card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        background: linear-gradient(135deg, var(--ia-panel) 0%, var(--ia-panel-2) 100%);
        border: 1px solid var(--ia-line);
        border-radius: 12px;
        padding: 2rem 1.8rem;
        text-decoration: none;
        color: var(--ia-text);
        transition: all 0.3s ease;
        overflow: hidden;
      }

      .topic-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, var(--ia-wire-soft), var(--ia-signal-soft));
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
      }

      .topic-card:hover {
        transform: translateY(-6px);
        border-color: var(--ia-wire);
        box-shadow: 0 16px 40px rgba(0, 217, 163, 0.15);
      }

      .topic-card:hover::before {
        opacity: 0.05;
      }

      .topic-card:focus-within {
        outline: 2px solid var(--ia-signal);
        outline-offset: -1px;
      }

      .topic-icon {
        font-size: 2rem;
        width: 3.2rem;
        height: 3.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--ia-panel-3), var(--ia-line));
        border: 1px solid var(--ia-line);
        border-radius: 10px;
      }

      .topic-card h4 {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.2rem;
        margin: 0;
        position: relative;
        z-index: 1;
      }

      .topic-card p {
        color: var(--ia-text-dim);
        font-size: 0.95rem;
        line-height: 1.65;
        margin: 0;
        flex-grow: 1;
        position: relative;
        z-index: 1;
      }

      .learn-more {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--ia-wire);
        position: relative;
        z-index: 1;
        transition: transform 0.3s ease;
      }

      .topic-card:hover .learn-more {
        transform: translateX(-4px);
      }

      /* Why Us / Features */
      .why-us {
        padding: 5.5rem 0;
        border-top: 1px solid var(--ia-line);
        background: linear-gradient(180deg, rgba(0, 217, 163, 0.04) 0%, transparent 100%);
      }

      .why-header {
        max-width: 600px;
      }

      .why-grid {
        max-width: 1200px;
        margin: 3rem auto 0;
        padding: 0 1.5rem;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3.5rem;
        align-items: start;
      }

      .features-list {
        display: grid;
        gap: 1.3rem;
      }

      .feature-item {
        display: flex;
        gap: 1.2rem;
        padding: 1.4rem;
        background: var(--ia-panel);
        border: 1px solid var(--ia-line);
        border-radius: 10px;
        transition: all 0.3s ease;
      }

      .feature-item:hover {
        background: var(--ia-panel-2);
        border-color: var(--ia-wire);
      }

      .feature-icon {
        font-size: 1.8rem;
        flex-shrink: 0;
      }

      .feature-item strong {
        font-family: var(--font-display);
        font-size: 1rem;
        color: var(--ia-text);
        display: block;
      }

      .feature-item p {
        color: var(--ia-text-dim);
        font-size: 0.9rem;
        margin: 0.4rem 0 0;
      }

      .benefit-box {
        background: linear-gradient(135deg, var(--ia-panel-2), var(--ia-panel));
        border: 1px solid var(--ia-line);
        border-radius: 12px;
        padding: 2rem;
      }

      .benefit-box h3 {
        font-family: var(--font-display);
        font-size: 1.3rem;
        margin: 0 0 1.5rem;
        color: var(--ia-text);
      }

      .benefit-box ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .benefit-box li {
        color: var(--ia-text-dim);
        line-height: 1.7;
        padding-inline-start: 1.2rem;
        position: relative;
      }

      .benefit-box strong {
        color: var(--ia-wire);
      }

      /* CTA Section */
      .cta {
        max-width: 1200px;
        margin: 5rem auto;
        padding: 4rem 2rem;
        background: linear-gradient(135deg, var(--ia-signal-light) 0%, var(--ia-wire-light) 100%);
        border: 2px solid var(--ia-line);
        border-radius: 16px;
        text-align: center;
      }

      .cta-content h2 {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 2rem;
        margin: 0 0 1rem;
        color: var(--ia-text);
      }

      .cta-content p {
        color: var(--ia-text-dim);
        font-size: 1.1rem;
        margin: 0 0 2rem;
        max-width: 500px;
        margin-inline: auto;
      }

      /* Contact */
      .contact {
        max-width: 1200px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
        text-align: center;
      }

      .contact p {
        color: var(--ia-text-dim);
        font-size: 1rem;
        margin: 0 0 0.8rem;
      }

      .contact-email {
        color: var(--ia-wire);
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
      }

      .contact-email:hover {
        transform: translateY(-2px);
        text-decoration: underline;
      }

      /* Footer */
      .site-footer {
        border-top: 1px solid var(--ia-line);
        background: var(--ia-panel);
        padding: 3rem 1.5rem;
        color: var(--ia-text-dim);
      }

      .footer-inner {
        max-width: 1200px;
        margin: 0 auto;
        text-align: center;
      }

      .site-footer p {
        margin: 0.5rem 0;
        font-size: 0.95rem;
      }

      .footer-note {
        color: var(--ia-text-faint);
        font-size: 0.85rem;
      }

      /* Responsive */
      @media (max-width: 1024px) {
        .hero-inner {
          grid-template-columns: 1fr;
        }

        .why-grid {
          grid-template-columns: 1fr;
        }

        .pipeline-container {
          gap: 1rem;
        }

        .pipeline-arrow {
          display: none !important;
        }
      }

      @media (max-width: 640px) {
        .buttons {
          flex-direction: column;
        }

        .btn {
          width: 100%;
          justify-content: center;
        }

        .topic-grid {
          grid-template-columns: 1fr;
        }

        .pipeline-container {
          flex-direction: column;
        }

        .cta {
          margin: 2rem 1.5rem;
        }
      }
    </style>
  </body>
</html>
