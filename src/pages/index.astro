---
// src/pages/index.astro
// Pure Visual DevOps Path - Minimal Text, Infinite Loop Animation

const devopsPath = [
  { step: "01", icon: "🔀", title: "Git", link: "/devops/git/git-01-מבוא-ומושגי-יסוד/", color: "#f14e32" },
  { step: "02", icon: "⚙️", title: "CI/CD", link: "/devops/cicd/01-מבוא-ל-cicd/", color: "#2088ff" },
  { step: "03", icon: "🐳", title: "Docker", link: "/devops/docker/01-מבוא-ל-docker/", color: "#2496ed" },
  { step: "04", icon: "☸️", title: "Kubernetes", link: "/devops/kubernetes/01-mavo-vearchitectura/", color: "#326ce5" },
];

const topics = [
  { icon: "🏗️", title: "Terraform", link: "/terraform/01-מבוא-ויסודות-terraform/" },
  { icon: "☁️", title: "AWS", link: "/aws/01_aws_introduction_and_global_infrastructure/" },
  { icon: "⎈", title: "Helm", link: "/devops/helm/01-mavo-le-helm/" },
  { icon: "🐧", title: "Linux", link: "/linux/01-פקודות-בסיסיות/" },
  { icon: "🪟", title: "Windows Server", link: "/windows-server/01_installation_and_basics/" },
  { icon: "🖥️", title: "VMware", link: "/vmware/01-virtualization-vmware-basics/" },
  { icon: "💻", title: "PowerShell", link: "/powershell/01-basics/" },
];
---

<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Royi Guides - מדריכים ל DEVOPS בעברית</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Background Animated Orbs -->
    <div class="bg-orb orb-1"></div>
    <div class="bg-orb orb-2"></div>

    <header class="navbar">
      <div class="container nav-inner">
        <a class="logo" href="/">
          <span>Royi <span class="highlight">Guides</span></span>
          <span class="logo-desc">- מדריכים ל DEVOPS בעברית</span>
        </a>
      </div>
    </header>

    <main>
      <!-- Hero: Infinite DevOps Loop with Stages -->
      <section class="hero-infinity fade-in-up">
        <div class="badge">CODE TO PRODUCTION</div>
        
        <!-- Animated DevOps Infinity SVG -->
        <div class="infinity-wrapper">
          <svg viewBox="0 0 800 300" class="infinity-svg" preserveAspectRatio="xMidYMid meet" style="overflow: visible;">
            <defs>
              <linearGradient id="infGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#f14e32" />
                <stop offset="33%" stop-color="#2088ff" />
                <stop offset="66%" stop-color="#2496ed" />
                <stop offset="100%" stop-color="#326ce5" />
              </linearGradient>
              <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="6" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>
            </defs>
            
            <!-- Shadow/Background Track -->
            <path d="M400,150 C300,300 100,300 100,150 C100,0 300,0 400,150 C500,300 700,300 700,150 C700,0 500,0 400,150 Z" 
                  fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="20" stroke-linecap="round" />
            
            <!-- Animated Flowing Beam -->
            <path d="M400,150 C300,300 100,300 100,150 C100,0 300,0 400,150 C500,300 700,300 700,150 C700,0 500,0 400,150 Z" 
                  fill="none" stroke="url(#infGrad)" stroke-width="10" stroke-linecap="round"
                  class="inf-path" filter="url(#glow)" />

            <!-- DEV CYCLE (Left Side) -->
            <g class="stage-node pulse-1" transform="translate(250, 53)">
              <circle r="8" fill="#050505" stroke="#f14e32" stroke-width="3" filter="url(#glow)"/>
              <text x="0" y="-18" text-anchor="middle" class="stage-text">PLAN</text>
            </g>
            <g class="stage-node pulse-2" transform="translate(100, 150)">
              <circle r="8" fill="#050505" stroke="#f14e32" stroke-width="3" filter="url(#glow)"/>
              <text x="-18" y="5" text-anchor="end" class="stage-text">CODE</text>
            </g>
            <g class="stage-node pulse-3" transform="translate(250, 247)">
              <circle r="8" fill="#050505" stroke="#2088ff" stroke-width="3" filter="url(#glow)"/>
              <text x="0" y="30" text-anchor="middle" class="stage-text">BUILD</text>
            </g>
            <g class="stage-node pulse-4" transform="translate(340, 150)">
              <circle r="8" fill="#050505" stroke="#2088ff" stroke-width="3" filter="url(#glow)"/>
              <text x="0" y="-18" text-anchor="middle" class="stage-text">TEST</text>
            </g>

            <!-- OPS CYCLE (Right Side) -->
            <g class="stage-node pulse-5" transform="translate(550, 53)">
              <circle r="8" fill="#050505" stroke="#2496ed" stroke-width="3" filter="url(#glow)"/>
              <text x="0" y="-18" text-anchor="middle" class="stage-text">RELEASE</text>
            </g>
            <g class="stage-node pulse-6" transform="translate(700, 150)">
              <circle r="8" fill="#050505" stroke="#326ce5" stroke-width="3" filter="url(#glow)"/>
              <text x="18" y="5" text-anchor="start" class="stage-text">DEPLOY</text>
            </g>
            <g class="stage-node pulse-7" transform="translate(550, 247)">
              <circle r="8" fill="#050505" stroke="#326ce5" stroke-width="3" filter="url(#glow)"/>
              <text x="0" y="30" text-anchor="middle" class="stage-text">OPERATE</text>
            </g>
            <g class="stage-node pulse-8" transform="translate(460, 150)">
              <circle r="8" fill="#050505" stroke="#2496ed" stroke-width="3" filter="url(#glow)"/>
              <text x="0" y="30" text-anchor="middle" class="stage-text">MONITOR</text>
            </g>
          </svg>
        </div>
      </section>

      <!-- Glassmorphism Pipeline Cards -->
      <section class="pipeline-section fade-in-up delay-1">
        <div class="container steps-grid">
          {devopsPath.map(step => (
            <a href={step.link} class="step-card" style={`--accent: ${step.color}`}>
              <div class="step-num">{step.step}</div>
              <h2>{step.icon} {step.title}</h2>
            </a>
          ))}
        </div>
      </section>

      <!-- Minimal Tech Stack Grid -->
      <section class="stack-section fade-in-up delay-2">
        <div class="container text-center">
          <div class="tech-grid">
            {topics.map(tech => (
              <a href={tech.link} class="tech-card">
                <span class="tech-icon">{tech.icon}</span>
                <span class="tech-name">{tech.title}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- Contact Section -->
      <section class="contact-section fade-in-up delay-3">
        <div class="container text-center">
          <p class="contact-text">
            ליצירת קשר ניתן לפנות במייל <a href="mailto:royiyahud@gmail.com" class="contact-email">royiyahud@gmail.com</a>
          </p>
        </div>
      </section>
    </main>

    <footer class="text-center fade-in-up delay-4">
      <p>© 2026 Royi Guides</p>
    </footer>

    <style>
      :root {
        --bg: #050505;
        --surface: rgba(255, 255, 255, 0.03);
        --surface-hover: rgba(255, 255, 255, 0.08);
        --border: rgba(255, 255, 255, 0.1);
        --text: #ffffff;
        --text-dim: #888888;
        --primary: #00e5ff;
        --font-sans: 'Heebo', sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      
      body {
        background: var(--bg); color: var(--text);
        font-family: var(--font-sans); overflow-x: hidden;
      }

      .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
      .text-center { text-align: center; }

      /* Background Animations */
      .bg-orb {
        position: absolute; border-radius: 50%; filter: blur(120px);
        z-index: -1; opacity: 0.3; animation: float 10s infinite ease-in-out alternate;
      }
      .orb-1 {
        width: 400px; height: 400px; background: rgba(0, 229, 255, 0.2);
        top: -100px; right: -100px;
      }
      .orb-2 {
        width: 500px; height: 500px; background: rgba(50, 108, 229, 0.2);
        bottom: 20%; left: -200px; animation-delay: -5s;
      }

      @keyframes float {
        0% { transform: translateY(0) scale(1); }
        100% { transform: translateY(50px) scale(1.1); }
      }

      /* Navbar */
      .navbar {
        padding: 1.5rem 0; position: relative; z-index: 10;
        border-bottom: 1px solid var(--border);
        background: rgba(5, 5, 5, 0.5); backdrop-filter: blur(10px);
      }
      .nav-inner { display: flex; align-items: center; justify-content: center; }
      .logo { 
        display: flex; align-items: center; gap: 8px;
        font-weight: 800; font-size: 1.25rem; color: var(--text); text-decoration: none; 
      }
      .logo .highlight { color: var(--primary); }
      .logo-desc { font-weight: 400; font-size: 1rem; color: var(--text-dim); margin-right: 4px; }

      /* Hero Infinity Loop */
      .hero-infinity { 
        padding: 4rem 0 2rem; 
        display: flex; flex-direction: column; align-items: center; justify-content: center;
      }
      .badge {
        display: inline-block; font-family: var(--font-mono); font-size: 0.8rem;
        letter-spacing: 2px; color: var(--primary); background: rgba(0, 229, 255, 0.1);
        padding: 6px 16px; border-radius: 99px; margin-bottom: 3rem;
        border: 1px solid rgba(0, 229, 255, 0.2);
      }

      /* Infinity SVG Animations & Texts */
      .infinity-wrapper { width: 100%; max-width: 900px; margin: 0 auto 2rem; }
      .infinity-svg { width: 100%; height: auto; display: block; }
      
      .inf-path {
        stroke-dasharray: 400 1600;
        animation: flowInf 4s linear infinite;
      }
      
      @keyframes flowInf {
        from { stroke-dashoffset: 2000; }
        to { stroke-dashoffset: 0; }
      }

      .stage-text {
        fill: #ffffff;
        font-family: var(--font-mono);
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1px;
      }

      .pulse-1 circle { animation: pulse 2s infinite alternate 0.0s; }
      .pulse-2 circle { animation: pulse 2s infinite alternate 0.2s; }
      .pulse-3 circle { animation: pulse 2s infinite alternate 0.4s; }
      .pulse-4 circle { animation: pulse 2s infinite alternate 0.6s; }
      .pulse-5 circle { animation: pulse 2s infinite alternate 0.8s; }
      .pulse-6 circle { animation: pulse 2s infinite alternate 1.0s; }
      .pulse-7 circle { animation: pulse 2s infinite alternate 1.2s; }
      .pulse-8 circle { animation: pulse 2s infinite alternate 1.4s; }

      @keyframes pulse {
        0% { transform: scale(1); filter: brightness(1); }
        100% { transform: scale(1.4); filter: brightness(1.6); }
      }

      /* Step Cards (Glassmorphism) */
      .pipeline-section { margin-bottom: 5rem; }
      .steps-grid {
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
        position: relative; z-index: 5;
      }
      .step-card {
        background: var(--surface); border: 1px solid var(--border);
        border-top: 2px solid var(--accent); border-radius: 12px;
        padding: 1.5rem; text-decoration: none; color: var(--text);
        transition: 0.3s; display: flex; flex-direction: column; align-items: center;
        backdrop-filter: blur(10px);
      }
      .step-card:hover {
        transform: translateY(-5px); background: var(--surface-hover);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5), 0 0 20px rgba(255,255,255,0.05);
      }
      .step-num { font-family: var(--font-mono); color: var(--text-dim); font-size: 0.8rem; margin-bottom: 0.5rem; }
      .step-card h2 { font-size: 1.25rem; font-weight: 600; }

      /* Tech Stack Chips */
      .stack-section { padding: 0 0 4rem; }
      .tech-grid {
        display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; max-width: 800px; margin: 0 auto;
      }
      .tech-card {
        display: flex; align-items: center; gap: 0.75rem;
        background: var(--surface); border: 1px solid var(--border);
        padding: 0.75rem 1.5rem; border-radius: 99px; text-decoration: none;
        color: var(--text); font-weight: 600; transition: 0.2s;
      }
      .tech-card:hover {
        background: var(--text); color: var(--bg); transform: scale(1.05);
      }
      .tech-icon { font-size: 1.2rem; }

      /* Contact Section */
      .contact-section {
        padding: 2rem 0;
        margin-bottom: 2rem;
      }
      .contact-text {
        font-size: 1.1rem;
        color: var(--text-dim);
      }
      .contact-email {
        color: var(--primary);
        font-family: var(--font-mono);
        text-decoration: none;
        font-weight: 700;
        margin-right: 5px;
        transition: color 0.3s ease, text-shadow 0.3s ease;
      }
      .contact-email:hover {
        color: #ffffff;
        text-shadow: 0 0 10px var(--primary);
      }

      /* Footer */
      footer { 
        padding: 2rem 0; 
        border-top: 1px solid var(--surface); 
        color: var(--text-dim); 
        font-size: 0.9rem; 
      }

      /* Entrance Animations */
      .fade-in-up { opacity: 0; transform: translateY(20px); animation: fadeInUp 0.8s forwards; }
      .delay-1 { animation-delay: 0.2s; }
      .delay-2 { animation-delay: 0.4s; }
      .delay-3 { animation-delay: 0.6s; }
      .delay-4 { animation-delay: 0.8s; }

      @keyframes fadeInUp {
        to { opacity: 1; transform: translateY(0); }
      }

      /* Responsive */
      @media (max-width: 900px) {
        .steps-grid { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
      }
      @media (max-width: 600px) {
        .logo { flex-direction: column; gap: 4px; text-align: center; }
        .logo-desc { margin-right: 0; font-size: 0.9rem; }
      }
      @media (max-width: 500px) {
        .steps-grid { grid-template-columns: 1fr; }
        .tech-card { width: 100%; justify-content: center; }
        .infinity-wrapper { padding: 0 1rem; }
        .stage-text { font-size: 12px; }
      }
    </style>
  </body>
</html>