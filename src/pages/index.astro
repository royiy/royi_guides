---
// src/pages/index.astro
// Minimal, Highly Animated, DevOps Pipeline Focus

const devopsPath = [
  { step: "01", icon: "🔀", title: "Git", link: "/devops/git/git-basics/", color: "#f14e32" },
  { step: "02", icon: "⚙️", title: "CI/CD", link: "/devops/cicd/01-מבוא-ל-cicd/", color: "#2088ff" },
  { step: "03", icon: "🐳", title: "Docker", link: "/devops/docker/01-מבוא-ל-docker/", color: "#2496ed" },
  { step: "04", icon: "☸️", title: "Kubernetes", link: "/devops/kubernetes/01-mavo-vearchitectura/", color: "#326ce5" },
];

const topics = [
  { icon: "🏗️", title: "Terraform", link: "/terraform/01-מבוא-ויסודות-terraform/" },
  { icon: "☁️", title: "AWS", link: "/aws/aws-exam/" },
  { icon: "🐧", title: "Linux", link: "/linux/01-פקודות-בסיסיות/" },
  { icon: "🪟", title: "Windows", link: "/windows-server/intro/" },
  { icon: "🖥️", title: "VMware", link: "/vmware/01-virtualization-vmware-basics/" },
  { icon: "💻", title: "PowerShell", link: "/powershell/01-basics/" },
];
---

<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Royi Guides | DevOps & Infrastructure</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Background Animated Orbs -->
    <div class="bg-orb orb-1"></div>
    <div class="bg-orb orb-2"></div>

    <header class="navbar">
      <div class="container nav-inner">
        <a class="logo" href="/">
          <span class="logo-icon">⚡</span> Royi<span class="highlight">Guides</span>
        </a>
        <a class="btn-sm" href="/devops/cicd/01-מבוא-ל-cicd/">🚀 התחל עכשיו</a>
      </div>
    </header>

    <main>
      <!-- Hero Section -->
      <section class="hero">
        <div class="container text-center">
          <div class="badge fade-in-up">PIPELINE TO PRODUCTION</div>
          <h1 class="fade-in-up delay-1">תשתיות ו-DevOps.<br/><span class="gradient-text">בלי בולשיט.</span></h1>
          <p class="hero-sub fade-in-up delay-2">כלים אמיתיים. מדריכים קצרים. ישר ולעניין.</p>
        </div>
      </section>

      <!-- Animated Pipeline Section -->
      <section class="pipeline-visual fade-in-up delay-3">
        <div class="container">
          
          <!-- Animated SVG Pipeline -->
          <div class="svg-container">
            <svg viewBox="0 0 1000 200" class="flow-svg" preserveAspectRatio="xMidYMid meet">
              <defs>
                <linearGradient id="lineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#f14e32" />
                  <stop offset="33%" stop-color="#2088ff" />
                  <stop offset="66%" stop-color="#2496ed" />
                  <stop offset="100%" stop-color="#326ce5" />
                </linearGradient>
                <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="5" result="blur" />
                  <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
              </defs>

              <!-- Base Track -->
              <path d="M 100 100 L 900 100" class="track-line" />
              <!-- Animated Data Flow -->
              <path d="M 100 100 L 900 100" class="data-line" />

              <!-- Nodes -->
              <g class="node pulse-1" transform="translate(100, 100)">
                <circle r="24" fill="#0b0f17" stroke="#f14e32" stroke-width="4" filter="url(#glow)"/>
                <text x="0" y="8" text-anchor="middle" font-size="20">🔀</text>
              </g>

              <g class="node pulse-2" transform="translate(366, 100)">
                <circle r="24" fill="#0b0f17" stroke="#2088ff" stroke-width="4" filter="url(#glow)"/>
                <text x="0" y="8" text-anchor="middle" font-size="20">⚙️</text>
              </g>

              <g class="node pulse-3" transform="translate(633, 100)">
                <circle r="24" fill="#0b0f17" stroke="#2496ed" stroke-width="4" filter="url(#glow)"/>
                <text x="0" y="8" text-anchor="middle" font-size="20">🐳</text>
              </g>

              <g class="node pulse-4" transform="translate(900, 100)">
                <circle r="24" fill="#0b0f17" stroke="#326ce5" stroke-width="4" filter="url(#glow)"/>
                <text x="0" y="8" text-anchor="middle" font-size="20">☸️</text>
              </g>
            </svg>
          </div>

          <!-- Interactive Steps -->
          <div class="steps-grid">
            {devopsPath.map(step => (
              <a href={step.link} class="step-card" style={`--accent: ${step.color}`}>
                <div class="step-num">{step.step}</div>
                <h2>{step.icon} {step.title}</h2>
              </a>
            ))}
          </div>

        </div>
      </section>

      <!-- Tech Stack Section (Minimal Grid) -->
      <section class="stack-section fade-in-up delay-4">
        <div class="container text-center">
          <h3 class="section-title">טכנולוגיות נוספות</h3>
          <div class="tech-grid">
            {topics.map(tech => (
              <a href={tech.link} class="tech-card">
                <span class="tech-icon">{tech.icon}</span>
                <span class="tech-name">{tech.title}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="text-center fade-in-up delay-5">
      <p>© 2026 Royi Guides</p>
    </footer>

    <style>
      :root {
        --bg: #050505;
        --surface: rgba(255, 255, 255, 0.03);
        --surface-hover: rgba(255, 255, 255, 0.08);
        --border: rgba(255, 255, 255, 0.1);
        --text: #ffffff;
        --text-dim: #888888;
        --primary: #00e5ff;
        --font-sans: 'Heebo', sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      
      body {
        background: var(--bg); color: var(--text);
        font-family: var(--font-sans); overflow-x: hidden;
      }

      .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
      .text-center { text-align: center; }

      /* Background Orbs Animation */
      .bg-orb {
        position: absolute; border-radius: 50%; filter: blur(120px);
        z-index: -1; opacity: 0.4; animation: float 10s infinite ease-in-out alternate;
      }
      .orb-1 {
        width: 400px; height: 400px; background: rgba(0, 229, 255, 0.2);
        top: -100px; right: -100px;
      }
      .orb-2 {
        width: 500px; height: 500px; background: rgba(50, 108, 229, 0.2);
        bottom: 20%; left: -200px; animation-delay: -5s;
      }

      @keyframes float {
        0% { transform: translateY(0) scale(1); }
        100% { transform: translateY(50px) scale(1.1); }
      }

      /* Navbar */
      .navbar {
        padding: 1.5rem 0; position: relative; z-index: 10;
        border-bottom: 1px solid var(--border);
        background: rgba(5, 5, 5, 0.5); backdrop-filter: blur(10px);
      }
      .nav-inner { display: flex; justify-content: space-between; align-items: center; }
      .logo { font-weight: 800; font-size: 1.25rem; color: var(--text); text-decoration: none; }
      .logo .highlight { color: var(--primary); }
      .btn-sm {
        background: var(--surface); border: 1px solid var(--border);
        color: var(--text); padding: 8px 16px; border-radius: 99px;
        text-decoration: none; font-size: 0.9rem; transition: 0.3s;
      }
      .btn-sm:hover { border-color: var(--primary); box-shadow: 0 0 15px rgba(0,229,255,0.2); }

      /* Typography & Hero */
      .hero { padding: 8rem 0 4rem; position: relative; z-index: 2; }
      .badge {
        display: inline-block; font-family: var(--font-mono); font-size: 0.8rem;
        letter-spacing: 2px; color: var(--primary); background: rgba(0, 229, 255, 0.1);
        padding: 6px 16px; border-radius: 99px; margin-bottom: 1.5rem;
        border: 1px solid rgba(0, 229, 255, 0.2);
      }
      h1 { font-size: clamp(3rem, 8vw, 5.5rem); line-height: 1.1; font-weight: 800; margin-bottom: 1rem; letter-spacing: -1px; }
      .gradient-text {
        background: linear-gradient(to left, #fff, #888);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      }
      .hero-sub { font-size: 1.25rem; color: var(--text-dim); }

      /* SVG Pipeline Animation */
      .pipeline-visual { margin: 2rem 0 5rem; position: relative; }
      .svg-container { width: 100%; overflow: hidden; margin-bottom: 2rem; }
      .flow-svg { width: 100%; max-height: 180px; display: block; overflow: visible; }
      
      .track-line { fill: none; stroke: var(--surface-hover); stroke-width: 4; }
      .data-line {
        fill: none; stroke: url(#lineGrad); stroke-width: 6;
        stroke-dasharray: 20 20; animation: flowData 1.5s linear infinite;
        filter: drop-shadow(0 0 8px rgba(0,229,255,0.5));
      }

      @keyframes flowData {
        from { stroke-dashoffset: 40; }
        to { stroke-dashoffset: 0; }
      }

      .node { transition: transform 0.3s ease; }
      .node:hover { transform: scale(1.2); cursor: pointer; }
      
      .pulse-1 circle { animation: pulseNode 2s infinite; }
      .pulse-2 circle { animation: pulseNode 2s infinite 0.5s; }
      .pulse-3 circle { animation: pulseNode 2s infinite 1s; }
      .pulse-4 circle { animation: pulseNode 2s infinite 1.5s; }

      @keyframes pulseNode {
        0% { filter: drop-shadow(0 0 0px var(--primary)); }
        50% { filter: drop-shadow(0 0 15px var(--primary)); }
        100% { filter: drop-shadow(0 0 0px var(--primary)); }
      }

      /* Step Cards (Glassmorphism) */
      .steps-grid {
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
        position: relative; z-index: 5;
      }
      .step-card {
        background: var(--surface); border: 1px solid var(--border);
        border-top: 2px solid var(--accent); border-radius: 12px;
        padding: 1.5rem; text-decoration: none; color: var(--text);
        transition: 0.3s; display: flex; flex-direction: column; align-items: center;
        backdrop-filter: blur(10px);
      }
      .step-card:hover {
        transform: translateY(-5px); background: var(--surface-hover);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5), 0 0 20px rgba(255,255,255,0.05);
      }
      .step-num { font-family: var(--font-mono); color: var(--text-dim); font-size: 0.8rem; margin-bottom: 0.5rem; }
      .step-card h2 { font-size: 1.25rem; font-weight: 600; }

      /* Tech Stack Grid */
      .stack-section { padding: 2rem 0 6rem; border-top: 1px solid var(--surface-hover); }
      .section-title { color: var(--text-dim); font-size: 1rem; margin-bottom: 2rem; font-weight: 400; letter-spacing: 1px; }
      .tech-grid {
        display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem;
      }
      .tech-card {
        display: flex; align-items: center; gap: 0.75rem;
        background: var(--surface); border: 1px solid var(--border);
        padding: 0.75rem 1.5rem; border-radius: 99px; text-decoration: none;
        color: var(--text); font-weight: 600; transition: 0.2s;
      }
      .tech-card:hover {
        background: var(--text); color: var(--bg); transform: scale(1.05);
      }
      .tech-icon { font-size: 1.2rem; }

      /* Footer */
      footer { padding: 2rem 0; border-top: 1px solid var(--border); color: var(--text-dim); font-size: 0.9rem; }

      /* Entrance Animations */
      .fade-in-up { opacity: 0; transform: translateY(20px); animation: fadeInUp 0.8s forwards; }
      .delay-1 { animation-delay: 0.1s; }
      .delay-2 { animation-delay: 0.2s; }
      .delay-3 { animation-delay: 0.4s; }
      .delay-4 { animation-delay: 0.6s; }
      .delay-5 { animation-delay: 0.8s; }

      @keyframes fadeInUp {
        to { opacity: 1; transform: translateY(0); }
      }

      /* Responsive */
      @media (max-width: 900px) {
        .steps-grid { grid-template-columns: repeat(2, 1fr); }
        .flow-svg { display: none; /* Hide horizontal SVG on mobile, focus on cards */ }
      }
      @media (max-width: 500px) {
        .steps-grid { grid-template-columns: 1fr; }
        .tech-card { width: 100%; justify-content: center; }
      }
    </style>
  </body>
</html>